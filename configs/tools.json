  {
    "id": "playwright",
    "name": "Playwright",
    "category": "Runtimes",
    "description": "Drives browsers for UAT screenshots and end-to-end evidence. Checked with npx without downloading it.",
    "required_runtimes": { "node": ">=18.0.0" },
    "health_check_cmd": "npx --no-install playwright --version",
    "install": {
      "docs": "https://playwright.dev/docs/intro",
      "commands": ["npm init playwright@latest", "npx playwright install"],
      "note": "Run inside the repository that holds the end-to-end tests."
    }
